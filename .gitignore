# Experiment archive: trained weights and pickled prediction dumps are too large
# for git (2.0 GB across 96 files; individual .pth are ~121 MB, over GitHub's
# 100 MB per-file limit). Everything else -- code, markdown, csv, json, figures --
# remains tracked.
实验档案/**/*.pth
实验档案/**/*.pkl
实验档案/**/*.pt
实验档案/**/*.pyc
实验档案/**/__pycache__/
实验档案/**/*.npy
实验档案/**/*.npz
实验档案/**/*.h5
实验档案/**/*.parquet

# Transport-only SlotSPE comparison runs: prepared feature caches and trained
# checkpoints are large (GB scale) and reproducible from the recorded config.
# The small JSON metadata (config, plan, protocol, status, curve) stays tracked.
experiments/**/out/prepared/
experiments/**/out/**/best.pt
experiments/**/out/**/last.pt
experiments/**/out/shared_initial.pt
experiments/**/out/**/*.pkl
